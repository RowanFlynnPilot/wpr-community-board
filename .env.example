# Both values come from Supabase: Project Settings -> API.
# The anon key is public by design — row-level security is the boundary.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: the public page readers actually visit (the WordPress embed page).
# Share links and deep links point here. Leave empty to use wherever the app
# itself is served (fine for local dev and the bare GitHub Pages URL).
VITE_PUBLIC_URL=
